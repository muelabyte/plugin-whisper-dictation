{
  "name": "opencode-whisper-dictation",
  "version": "0.2.1",
  "type": "module",
  "description": "Plugin de OpenCode: botón de micrófono en la barra de entrada del chat que transcribe voz a texto con Whisper medium cuantizado (local, INT8/GGUF).",
  "license": "MIT",
  "author": "muelabyte <muelabyte@users.noreply.github.com>",
  "homepage": "https://github.com/muelabyte/plugin-whisper-dictation/tree/main/opencode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muelabyte/plugin-whisper-dictation.git",
    "directory": "opencode"
  },
  "bugs": {
    "url": "https://github.com/muelabyte/plugin-whisper-dictation/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "whisper",
    "dictation",
    "speech-to-text",
    "faster-whisper",
    "voice",
    "tui"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./dictation": "./src/dictation.ts"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "src",
    "whisper",
    "scripts",
    "examples",
    "tsconfig.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.32"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0",
    "typescript": "^5.6.0"
  }
}
