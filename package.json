{
  "name": "opencode-whisper-dictation",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Envoltorio de compatibilidad para instalar el plugin de OpenCode desde Git; el paquete real vive en opencode/.",
  "license": "MIT",
  "exports": {
    ".": "./opencode/src/index.ts",
    "./tui": "./opencode/src/tui.tsx",
    "./dictation": "./opencode/src/dictation.ts"
  },
  "files": [
    "opencode/index.ts",
    "opencode/tui.tsx",
    "opencode/src",
    "opencode/whisper",
    "opencode/scripts",
    "opencode/examples",
    "opencode/tsconfig.json",
    "LICENSE"
  ],
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "npm --prefix opencode run typecheck",
    "test": "npm --prefix dsh-whisper-provider test",
    "pack:check": "npm --prefix opencode run pack:check",
    "pack:check:dsh": "npm --prefix dsh-whisper-provider run pack:check"
  },
  "os": ["win32", "darwin", "linux"],
  "dependencies": { "@opencode/plugin": "^2.0.32" },
  "optionalDependencies": { "ffmpeg-static": "^5.2.0" },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  }
}